{
    "name": "@phrmendes/pi-plan-mode",
    "version": "1.0.0",
    "description": "Plan mode for pi: restricted discovery, structured proposal review, and durable implementation sessions",
    "keywords": [
        "pi-package"
    ],
    "homepage": "https://github.com/phrmendes/pi-plan-mode",
    "bugs": "https://github.com/phrmendes/pi-plan-mode/issues",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/phrmendes/pi-plan-mode.git"
    },
    "files": [
        "src",
        "prompts",
        "!src/*.test.ts"
    ],
    "type": "module",
    "scripts": {
        "test": "node --test src/config.test.ts src/index.test.ts src/plan.test.ts src/state.test.ts",
        "test:e2e": "node --test src/e2e.test.ts",
        "check": "pnpm run typecheck && pnpm run format:check && pnpm test && pnpm run test:e2e",
        "typecheck": "tsc -p tsconfig.json",
        "format": "prettier --write src/",
        "format:check": "prettier --check src/",
        "pack:check": "rm -rf /tmp/pi-plan-mode-pack && mkdir -p /tmp/pi-plan-mode-pack && pnpm pack --pack-destination /tmp/pi-plan-mode-pack && tar -tf /tmp/pi-plan-mode-pack/*.tgz"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "latest",
        "@earendil-works/pi-coding-agent": "latest",
        "@earendil-works/pi-tui": "latest",
        "prettier": "^3.9.6",
        "typescript": "latest"
    },
    "packageManager": "pnpm@11.17.0",
    "pi": {
        "extensions": [
            "./src/index.ts"
        ]
    }
}
