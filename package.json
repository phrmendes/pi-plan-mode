{
    "name": "@phrmendes/pi-plan-mode",
    "version": "1.0.0",
    "description": "Plan mode for pi: restricted discovery, structured proposal review, and durable implementation sessions",
    "license": "Apache-2.0",
    "type": "module",
    "keywords": [
        "pi-package"
    ],
    "files": [
        "src",
        "prompts",
        "!src/*.test.ts"
    ],
    "scripts": {
        "test": "node --test src/index.test.ts src/policy.test.ts src/state.test.ts",
        "test:e2e": "node --test src/e2e.test.ts",
        "typecheck": "tsc -p tsconfig.json",
        "format": "prettier --write src/",
        "format:check": "prettier --check src/",
        "lint": "tsc -p tsconfig.json",
        "pack:check": "rm -rf /tmp/pi-plan-mode-pack && mkdir -p /tmp/pi-plan-mode-pack && pnpm pack --pack-destination /tmp/pi-plan-mode-pack && tar -tf /tmp/pi-plan-mode-pack/*.tgz"
    },
    "dependencies": {
        "@earendil-works/pi-tui": "0.84.2",
        "shell-quote": "^1.8.4",
        "typebox": "^1.3.14"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "0.84.2",
        "@earendil-works/pi-coding-agent": "0.84.0",
        "prettier": "^3.9.6",
        "typescript": "latest"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*"
    },
    "overrides": {
        "@earendil-works/pi-coding-agent": {
            "brace-expansion": "^5.0.8"
        }
    },
    "packageManager": "pnpm@11.17.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/phrmendes/pi-plan-mode.git"
    },
    "bugs": "https://github.com/phrmendes/pi-plan-mode/issues",
    "homepage": "https://github.com/phrmendes/pi-plan-mode",
    "pi": {
        "extensions": [
            "./src/index.ts"
        ]
    }
}
